{
  "name": "tirtil-yt-downloader",
  "productName": "Tırtıl",
  "version": "1.5.1",
  "description": "Tırtıl YT Downloader — YouTube toplu ses/video indirici (macOS)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:engine": "./scripts/build_engine.sh",
    "build": "npm run build:engine && electron-builder --mac --arm64",
    "build:x64": "npm run build:engine && electron-builder --mac --x64"
  },
  "author": "ATi__ (atillaazizi)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.atillaazizi.tirtil",
    "productName": "Tırtıl",
    "afterPack": "scripts/adhoc-sign.js",
    "copyright": "MIT — ATi__, based on dotu-yt by rtrw_",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/engine/ati-engine",
        "to": "engine"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "ffmpeg/ffmpeg"
      },
      {
        "from": "bin/node",
        "to": "bin/node"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Tırtıl",
      "writeUpdateInfo": false,
      "artifactName": "Tirtil-${version}-${arch}.${ext}"
    },
    "electronLanguages": [
      "en",
      "tr"
    ],
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atillaazizi/tirtil-yt-downloader.git"
  }
}
